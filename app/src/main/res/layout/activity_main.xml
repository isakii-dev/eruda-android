<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:hardwareAccelerated="true"
    tools:context=".MainActivity">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:max="100"
        android:progress="50" />

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:background="@drawable/dock_panel"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp"
        android:visibility="invisible"
        tools:visibility="visible">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/dock_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/dock_input"
            android:gravity="center_vertical"
            android:paddingStart="5dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/webIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="favicon"
                android:padding="7dp"
                android:src="@drawable/tool" />

            <AutoCompleteTextView
                android:id="@+id/textUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:completionThreshold="1"
                android:gravity="center_vertical"
                android:hint="@string/input_url"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/input_color"
                android:textColorHint="#9f9f9f"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_row"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/goBack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="back"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/dock_icon" />

            <ImageView
                android:id="@+id/goForward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="forward"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_right"
                android:tint="@color/dock_icon" />

            <ImageView
                android:id="@+id/btnRefresh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="refresh"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_refresh"
                android:tint="@color/dock_icon" />

            <ImageView
                android:id="@+id/btnBookmark"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="favorite"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_star"
                android:tint="@color/dock_icon" />

            <ImageView
                android:id="@+id/btnHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="history"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_history"
                android:tint="@color/dock_icon" />

            <ImageView
                android:id="@+id/btnBookmarksList"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="favorites"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_bookmarks"
                android:tint="@color/dock_icon" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="settings"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                android:tint="@color/dock_icon" />

        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fab"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="top|start"
        android:alpha="0"
        android:background="@drawable/fab_bg"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:visibility="invisible"
        tools:alpha="0.35"
        tools:visibility="visible">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="controls"
            android:src="@drawable/ic_dock"
            android:tint="@color/white" />
    </FrameLayout>

</FrameLayout>
